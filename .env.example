# Copia este archivo como .env y completa los valores. .env nunca se sube a git.

# PostgreSQL (local con Docker o en la nube: Neon, Supabase, etc.)
DATABASE_URL=postgres://remotefit:remotefit@localhost:5433/remotefit

# Base SOLO para pruebas: su nombre DEBE terminar en _test. Las pruebas de base de datos vacian tablas
# (truncate) y se niegan a correr si el nombre no termina en _test. Nunca apuntes esto a la base real.
# Crearla: docker exec remotefit-db-1 psql -U remotefit -d postgres -c "create database remotefit_test"
# Migrarla: DATABASE_URL=<esta misma URL> npm run db:migrate
TEST_DATABASE_URL=postgres://remotefit:remotefit@localhost:5433/remotefit_test

# Clave de la capa gratuita de la API de Gemini (Google AI Studio), sin facturacion vinculada (ADR 0005).
# Usa SIEMPRE este nombre. No crees ANTHROPIC_API_KEY como variable de entorno global:
# si existe, Claude Code la usa y te cobra por API en vez de usar tu plan.
GEMINI_API_KEY=

# Modelo por defecto: lo decide el informe de evaluacion (S7b).
# Los limites RPM, TPM y RPD van en data/llm-limits.json.
RF_LLM_PROVIDER=gemini
RF_LLM_MODEL_CLASSIFY=

# API
PORT=3001

# Contador de cuota compartido (S11). El eval local lo usa para contar contra la misma cuota que el cron publicado.
# Vacio = usa DATABASE_URL. Despues de publicar, ponle la URL de Neon (docs/despliegue.md).
QUOTA_DATABASE_URL=
