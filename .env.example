# Copia este archivo como .env y completa los valores. .env nunca se sube a git.

# PostgreSQL (local con Docker o en la nube: Neon, Supabase, etc.)
DATABASE_URL=postgres://remotefit:remotefit@localhost:5432/remotefit

# Clave de la API del LLM (se paga aparte del plan Pro de Claude).
# Usa SIEMPRE este nombre. No crees ANTHROPIC_API_KEY como variable de entorno global:
# si existe, Claude Code la usa y te cobra por API en vez de usar tu plan.
RF_LLM_API_KEY=

# Modelos (ajusta segun precios y resultados del eval)
RF_LLM_PROVIDER=anthropic
RF_LLM_MODEL_CLASSIFY=
RF_LLM_MODEL_FIT=

# API
PORT=3001
